# ==============================
# DATABASE CONFIGURATION
# ==============================

# Name of the MySQL database
DB_NAME=

# Database user with access permissions
DB_USER=	

# Password for the database user
DB_PASSWORD=

# Database server host (IP or domain)
DB_HOST=

# Database server port (default MySQL is 3306)
DB_PORT=3306


# ==============================
# JWT / AUTHENTICATION SETTINGS
# ==============================

# Secret key used to sign JWT tokens (keep this safe)
SECRET_KEY=

# Algorithm used to sign JWT tokens
ALGORITHM=HS256

# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token lifetime in minutes
REFRESH_TOKEN_EXPIRE=60

# ==============================
# COOKIE SETTINGS
# ==============================

# Max lifetime of the authentication cookie in minutes
# Used to support refresh token strategies
AUTH_COOKIE_MAX_AGE=1440

# Secret used to sign and validate secure cookies (HMAC)
COOKIE_SECRET=

# Short-lived TTL in minutes
# Used for email confirmation codes, password reset codes, etc.
SHORT_LIVED_TTL_MINUTES=5


# ==============================
# CORS SETTINGS
# ==============================

# Allowed frontend domains (comma-separated, HTTPS only)
CORS_ORIGINS=https://localhost:4200


# ==============================
# EMAIL (SMTP) CONFIGURATION
# ==============================

# SMTP server address
MAIL_SERVER=smtp.gmail.com

# SMTP server port (587 for STARTTLS)
MAIL_PORT=587

# Email account used to send system emails
MAIL_USERNAME=user@gmail.com

# App password or SMTP password for the email account
# https://myaccount.google.com/apppasswords
MAIL_PASSWORD=

# Default "from" email address
MAIL_FROM=user@gmail.com

# Display name shown in sent emails
MAIL_FROM_NAME=FastAPI

# Enable STARTTLS encryption
MAIL_STARTTLS=True

# Enable SSL/TLS (should be False when using STARTTLS)
MAIL_SSL_TLS=False


# ==============================
# APPLICATION SETTINGS
# ==============================

# Application name (used in emails and logs)
APP_NAME=FastAPI

# Frontend base URL (used for email links)
FRONT_URL=https://localhost:4200
